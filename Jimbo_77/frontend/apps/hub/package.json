{
  "name": "@jimbo77/hub",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "test": "vitest",
    "build": "tsc -p tsconfig.json && vite build",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=jimbo-devz-inc-hub",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
