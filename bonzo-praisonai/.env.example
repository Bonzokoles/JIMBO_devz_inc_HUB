# OpenAI API Key (for PraisonAI agents)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (optional, for Claude models)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenRouter API Key (for cost tracking)
OPENROUTER_API_KEY=your-openrouter-key-here

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your-cloudflare-token-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# GitHub Token (for deployment coordinator)
GITHUB_TOKEN=your-github-token-here
GITHUB_ORG=Bonzokoles

# Slack Webhooks (optional, for alerts)
SLACK_WEBHOOK_URL=your-slack-webhook-url-here

# Database Configuration
REDIS_URL=redis://host.docker.internal:6379/1
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=bonzo_ai
POSTGRES_USER=bonzo
POSTGRES_PASSWORD=your-postgres-password-here

# Agent-Zero MCP Integration
AGENT_ZERO_URL=http://host.docker.internal:50100
AGENT_ZERO_MCP_TOKEN=your-mcp-token-here

# Budget Configuration
DAILY_BUDGET_USD=5.0
MONTHLY_BUDGET_USD=100.0

# Service Ports
COST_OPTIMIZER_PORT=6002
GUARDIAN_AGENT_PORT=6004
WORKER_HEALTH_MONITOR_PORT=6003
DASHBOARD_PORT=6100

# Agent Configuration
CHECK_INTERVAL_SECONDS=300
EMERGENCY_STOP_ENABLED=true
LOG_LEVEL=info

# Model Configuration (PraisonAI)
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=2000
