{
  "name": "ai-marketplace",
  "version": "1.0.0",
  "description": "Universal AI Task Marketplace on Cloudflare",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --sourcemap --target=es2020 --outfile=dist/index.js --format=esm --external:cloudflare --conditions=worker",
    "dev": "wrangler dev",
    "deploy": "wrangler publish",
    "deploy:prod": "wrangler publish --env production",
    "db:migrate": "wrangler d1 migrations apply ai-marketplace",
    "db:local": "wrangler d1 local",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "vitest"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "hono": "^4.0.0",
    "jose": "^5.2.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240122.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "wrangler": "^3.26.0"
  },
  "engines": {
    "node": "^18.0.0"
  }
}
